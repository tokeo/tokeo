{% extends "frame.html.jinja2" %}
{#- the way back to the root of the docs, so every path is relative -#}
{% set docs_root_path = "" %}

{% block title %}{{ app_label | default("tokeo") }} · {{ doc_title }}{% endblock %}
{% block style %}<link rel="stylesheet" href="{{ docs_root_path }}assets/tailwind.min.css"><link rel="stylesheet" href="{{ docs_root_path }}assets/tokeo.theme.css">{% endblock %}
{% block head %}{% include "head.html" %}{% endblock %}

{% block body %}
  <div class="min-h-screen tk-page text-brand-ink font-sans flex flex-col">
    <main class="flex-1 w-full max-w-6xl mx-auto px-6 py-12">
      <div class="tk-mode-row">{% include "mode.html" %}</div>
      <div class="tk-header">
        <h1>🚀 {{ app_label | default("tokeo") }} modules</h1>
        <p>Explore the API documentation of project modules</p>
      </div>

      {# top-level packages only: a module whose parent is not itself documented #}
      {% set top_modules = [] %}
      {% for name, mod in all_modules.items() %}
        {% set parent = name.rsplit('.', 1)[0] if '.' in name else '' %}
        {% if mod and parent not in all_modules %}{% set _ = top_modules.append((name, mod)) %}{% endif %}
      {% endfor %}

      {% if not top_modules and not has_config %}
        <p class="text-brand-muted mt-8">No modules found.</p>
      {% else %}
        <div class="grid gap-8 mt-10 grid-cols-1 md:grid-cols-2">
          {% for name, mod in top_modules %}
            <div class="relative overflow-hidden rounded-xl border tk-line tk-surface p-7 shadow-md transition-transform hover:-translate-y-1 hover:shadow-xl">
              <div class="absolute inset-x-0 top-0 h-1" style="background: var(--gradient-brand)"></div>
              <a href="{{ docs_root_path }}{{ name.replace(".", "/") }}.html" class="text-xl font-semibold text-brand-secondary hover:text-brand-accent break-all">{{ name }}</a>
              {% set _w = (mod.docstring or "").split("\n\n")[0].split() %}{% set _summary = _w[:75] | join(" ") %}{% if _w | length > 75 %}{% set _summary = _summary ~ " …" %}{% endif %}<div class="tk-doc mt-4 text-brand-muted leading-relaxed">{{ _summary | to_html }}</div>
            </div>
          {% endfor %}

          {% if has_config %}
            <div class="relative overflow-hidden rounded-xl border tk-line tk-surface p-7 shadow-md transition-transform hover:-translate-y-1 hover:shadow-xl">
              <div class="absolute inset-x-0 top-0 h-1" style="background: var(--gradient-brand)"></div>
              <a href="{{ docs_root_path }}config/index.html" class="text-xl font-semibold text-brand-secondary hover:text-brand-accent break-all">config</a>
              <div class="tk-doc mt-4 text-brand-muted leading-relaxed"><p>The configuration files and their sections.</p></div>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </main>
    <footer class="border-t tk-line-strong tk-footer px-6 py-6 text-sm text-brand-muted text-center">
      Generated with <a class="text-brand-primary hover:text-brand-accent" href="https://github.com/tokeo/tokeo">Tokeo</a> 🚀{% if tokeo_version %} ( {{ tokeo_version }} ){% endif %} and <a class="text-brand-primary hover:text-brand-accent" href="https://pdoc.dev">pdoc</a>{% if pdoc_version %} ( {{ pdoc_version }} ){% endif %}
    </footer>
  </div>
{% endblock %}
