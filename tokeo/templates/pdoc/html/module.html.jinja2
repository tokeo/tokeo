{% extends "frame.html.jinja2" %}

{#- ================================================================== -#}
{#- Tokeo API documentation — Tailwind-based presentation.             -#}
{#- Built on pdoc's MIT frame + API; styling is original Tailwind      -#}
{#- utility composition against the Tokeo brand theme.                 -#}
{#- ================================================================== -#}

{% block title %}{{ module.modulename }} · {{ doc_title }}{% endblock %}
{% block style %}<link rel="stylesheet" href="/assets/tailwind.min.css"><link rel="stylesheet" href="/assets/tokeo.theme.css">{% endblock %}
{% block head %}{% include "head.html" %}{% endblock %}

{#- ---------- helpers ---------- -#}
{% macro is_public(doc) %}
  {% if "@private" in (doc.docstring or "") %}
  {% elif "@public" in (doc.docstring or "") %}true
  {% elif doc.name == "__doc__" %}
  {% elif doc.kind == "variable" and doc.is_typevar and not doc.docstring %}
  {% elif doc.name == "__init__" and (doc.docstring or (doc.kind == "function" and doc.signature_without_self.parameters)) %}true
  {% elif (doc.qualname or doc.name) is in(module.obj.__all__ or []) %}true
  {% elif not doc.name.startswith("_") %}true
  {% endif %}
{% endmacro %}

{% macro tbadge(kind) -%}{%- set _m = {"module":["M","text-brand-primary"],"class":["C","text-brand-ident"],"enum":["E","text-teal-600"],"function":["ƒ","text-amber-600"],"variable":["V","text-slate-500"]} -%}{%- set _b = _m[kind] -%}<span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded font-mono text-[0.6rem] font-bold bg-black/[0.06] {{ _b[1] }}">{{ _b[0] }}</span>{%- endmacro %}
{% macro glimpse(doc) %}{% set _w = (doc.docstring or "").split("\n\n")[0].split() %}{{ _w[:75] | join(" ") }}{% if _w | length > 75 %} …{% endif %}{% endmacro %}
{% macro doc_html(doc) %}<div class="tk-doc">{{ doc.docstring | to_html }}</div>{% endmacro %}

{% macro sigbox(d) %}
  {% if d.source and show_source %}
  <details class="group">
    <summary class="block rounded-lg border border-brand-primary/10 bg-gradient-to-br from-[#f4f8fb] to-[#e6f0f6] px-5 py-3 shadow-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <div class="grid grid-cols-[1fr_auto] items-baseline gap-4">
        <span class="min-w-0 overflow-x-auto font-mono text-[0.95rem] leading-relaxed">{{ caller() }}</span>
        <span class="justify-self-end font-sans text-[0.68rem] font-semibold uppercase tracking-wide text-brand-muted group-open:text-brand-accent select-none whitespace-nowrap">Expand</span>
      </div>
    </summary>
    <div class="mt-3 max-h-[500px] overflow-auto rounded-xl bg-[#231e18] p-4"><pre class="!m-0 !bg-transparent !border-0"><code class="language-python !text-[0.8rem] !leading-relaxed">{{ d.source }}</code></pre></div>
  </details>
  {% else %}
  <div class="rounded-lg border border-brand-primary/10 bg-gradient-to-br from-[#f4f8fb] to-[#e6f0f6] px-5 py-3 font-mono text-[0.95rem] leading-relaxed shadow-sm overflow-x-auto">{{ caller() }}</div>
  {% endif %}
{% endmacro %}

{% macro show_func(f) %}
  <div id="{{ f.qualname }}" class="scroll-mt-6 target:ring-2 target:ring-brand-highlight rounded-lg">
    {% call sigbox(f) %}{% set _decs = decorators(f) %}{% if _decs %}{% for dec in _decs %}<span class="block text-brand-secondary/80">{{ dec.decorator }}{%- if dec.params %}<span class="text-brand-muted">({{ dec.params }})</span>{% endif %}</span>{% endfor %}{% else %}{% for dec in f.decorators %}<span class="block text-brand-secondary/80">{{ dec }}</span>{% endfor %}{% endif %}<span class="font-bold text-brand-secondary">{{ f.funcdef }}</span> <span class="font-bold text-brand-ident">{{ f.name }}</span><span class="text-brand-ink">{{ f.signature }}</span>{% endcall %}
    <div class="mt-3 pl-5 tk-member-doc">{{ doc_html(f) }}</div>
  </div>
{% endmacro %}

{% macro show_var(v) %}
  <div id="{{ v.qualname }}" class="scroll-mt-6 target:ring-2 target:ring-brand-highlight rounded-lg">
    {% call sigbox(v) %}<span class="text-brand-muted">{{ v.kind }}</span> <span class="font-bold text-brand-ident">{{ v.name }}</span>{% if v.annotation_str %}<span class="text-brand-ink">{{ v.annotation_str }}</span>{% endif %}{% endcall %}
    <div class="mt-3 pl-5 tk-member-doc">{{ doc_html(v) }}</div>
  </div>
{% endmacro %}

{% macro subhead(text) %}<h3 class="mt-10 mb-4 text-lg font-semibold text-brand-primary">{{ text }}</h3>{% endmacro %}

{% macro show_class(c) %}
  <div id="{{ c.qualname }}" class="scroll-mt-6 target:ring-2 target:ring-brand-highlight rounded-lg">
    {% call sigbox(c) %}{% set init = own_init(c) %}<span class="font-bold text-brand-secondary">class</span> <span class="font-bold text-brand-ident">{{ c.name }}</span>{% if init %} <span class="tk-sig text-brand-ink">{{ init.signature_without_self | format_signature(colon=False) | linkify }}</span>{% endif %}{% endcall %}
    <div class="mt-4 pl-5">
      <div class="tk-member-doc">{{ doc_html(c) }}</div>

      {% set anc = ancestors(c, ancestors_max_depth) %}
      {% if anc %}
        {{ subhead("Ancestors") }}
        <ul class="list-none pl-0 flex flex-wrap gap-x-1 font-mono text-sm">{% for b in anc %}<li class="after:content-[','] last:after:content-['']">{% if b[0] in all_modules %}<a class="text-brand-primary hover:text-brand-accent" href="/{{ b[0].replace('.', '/') }}.html#{{ b[1] }}">{{ b[2] }}</a>{% else %}{{ b[2] }}{% endif %}</li>{% endfor %}</ul>
      {% endif %}

      {% set subs = subclasses(c) %}
      {% if subs %}
        {{ subhead("Subclasses") }}
        <ul class="list-none pl-0 flex flex-wrap gap-x-3 gap-y-1 font-mono text-sm">{% for s in subs %}<li>{% if s[0] in all_modules %}<a class="text-brand-primary hover:text-brand-accent" href="/{{ s[0].replace('.', '/') }}.html#{{ s[1] }}">{{ s[1] }}</a>{% else %}{{ s[2] }}{% endif %}</li>{% endfor %}</ul>
      {% endif %}

      {% set class_vars = [] %}
      {% for v in c.own_members if v.kind == "variable" and v.is_classvar and is_public(v) | trim %}{% set _ = class_vars.append(v) %}{% endfor %}{% set class_vars = class_vars | sort(attribute='name') %}
      {% if class_vars %}{{ subhead("Class variables") }}<div class="space-y-6">{% for v in class_vars %}{{ show_var(v) }}{% endfor %}</div>{% endif %}

      {% set smethods = [] %}
      {% for f in c.own_members if f.kind == "function" and f.name != "__init__" and is_public(f) | trim %}{% set _ = smethods.append(f) %}{% endfor %}{% set smethods = smethods | sort(attribute='name') %}
      {% if smethods %}{{ subhead("Methods") }}<div class="space-y-6">{% for f in smethods %}{{ show_func(f) }}{% endfor %}</div>{% endif %}

      {% set inst_vars = [] %}
      {% for v in c.own_members if v.kind == "variable" and not v.is_classvar and is_public(v) | trim %}{% set _ = inst_vars.append(v) %}{% endfor %}{% set inst_vars = inst_vars | sort(attribute='name') %}
      {% if inst_vars %}{{ subhead("Instance variables") }}<div class="space-y-6">{% for v in inst_vars %}{{ show_var(v) }}{% endfor %}</div>{% endif %}

      {% set documented_inherited = [] %}
      {% for parent, mems in c.inherited_members.items() %}
        {% if parent[0] in all_modules %}
          {% set pub_mems = [] %}{% for m in mems if is_public(m) | trim %}{% set _ = pub_mems.append(m) %}{% endfor %}
          {% if pub_mems %}{% set _ = documented_inherited.append((parent, pub_mems)) %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if documented_inherited %}
        {{ subhead("Inherited members") }}
        <ul class="list-none pl-0 space-y-1 text-sm">
        {% for parent, mems in documented_inherited %}
          <li><a class="font-bold text-brand-primary hover:text-brand-accent" href="/{{ parent[0].replace('.', '/') }}.html#{{ parent[1] }}"><code>{{ parent[1] }}</code></a>: <span class="text-brand-muted">{% for m in mems %}<a class="text-brand-primary hover:text-brand-accent" href="/{{ parent[0].replace('.', '/') }}.html#{{ parent[1] }}.{{ m.name }}"><code>{{ m.name }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</span></li>
        {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endmacro %}

{#- ---------- page ---------- -#}
{% block body %}
  {# submodules: all documented direct children (independent of __all__, which
     pdoc's module.submodules honours and would otherwise hide them) #}
  {% set pub_submodules = [] %}{% for name, mod in all_modules.items() %}{% if mod and '.' in name and name.rsplit('.', 1)[0] == module.modulename %}{% set _ = pub_submodules.append(mod) %}{% endif %}{% endfor %}{% set pub_submodules = pub_submodules | sort(attribute='modulename') %}

  {# partition members into own vs. re-exported (taken_from points elsewhere) #}
  {% set own_variables = [] %}{% set own_functions = [] %}{% set own_classes = [] %}{% set reexported = [] %}
  {% for v in module.variables if is_public(v) | trim and v.docstring %}{% if v.taken_from and v.taken_from[0] != module.modulename %}{% set _ = reexported.append(v) %}{% else %}{% set _ = own_variables.append(v) %}{% endif %}{% endfor %}
  {% for f in module.functions if is_public(f) | trim %}{% if f.taken_from and f.taken_from[0] != module.modulename %}{% set _ = reexported.append(f) %}{% else %}{% set _ = own_functions.append(f) %}{% endif %}{% endfor %}
  {% for c in module.classes if is_public(c) | trim %}{% if c.taken_from and c.taken_from[0] != module.modulename %}{% set _ = reexported.append(c) %}{% else %}{% set _ = own_classes.append(c) %}{% endif %}{% endfor %}
  {% set re_sources = [] %}{% for m in reexported %}{% if m.taken_from[0] not in re_sources %}{% set _ = re_sources.append(m.taken_from[0]) %}{% endif %}{% endfor %}
  {% set reexported = reexported | sort(attribute='name') %}{% set re_sources = re_sources | sort %}
  {% set own_variables = own_variables | sort(attribute='name') %}{% set own_functions = own_functions | sort(attribute='name') %}{% set own_classes = own_classes | sort(attribute='name') %}
  {% set parent_name = module.modulename.rsplit('.', 1)[0] if '.' in module.modulename else '' %}

  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 text-brand-ink font-sans flex flex-col">
    <div class="flex flex-1 flex-col md:flex-row">
    {# ---------- sidebar ---------- #}
    <aside class="md:w-72 md:shrink-0 md:h-screen md:sticky md:top-0 md:overflow-auto border-b md:border-b-0 md:border-r border-black/5 bg-white px-6 py-7">
      <a href="/" class="tk-header block !py-3 !px-4 !mb-7 !text-left"><span class="text-lg font-semibold">{{ brand | default("🚀 " + (app_name | default("tokeo")), true) }}</span></a>
      <nav class="space-y-7 text-[0.95rem] font-sans whitespace-nowrap">
        <div>
          <h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Home</h3>
          <a href="/" class="text-brand-primary hover:text-brand-accent">All packages</a>
        </div>
        {% if parent_name %}
        <div>
          <h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Super-Module</h3>
          <a href="/{{ parent_name.replace(".", "/") }}.html" class="text-brand-primary hover:text-brand-accent whitespace-nowrap">{{ parent_name }}</a>
        </div>
        {% endif %}
        {% if pub_submodules %}<div><h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Sub-modules</h3><ul class="space-y-1">{% for m in pub_submodules %}<li><a class="text-brand-primary hover:text-brand-accent whitespace-nowrap" href="/{{ m.modulename.replace(".", "/") }}.html">{{ m.modulename }}</a></li>{% endfor %}</ul></div>{% endif %}
        {% if own_classes %}<div><h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Classes</h3>
        {% set ns = namespace(any_expandable=false) %}{% for c in own_classes %}{% for mm in c.own_members if is_public(mm) | trim and mm.name != "__init__" and (mm.kind == "function" or mm.kind == "variable") %}{% set ns.any_expandable = true %}{% endfor %}{% endfor %}<div class="space-y-1">{% for c in own_classes %}{% set cmembers = [] %}{% for mm in c.own_members if is_public(mm) | trim and mm.name != "__init__" and (mm.kind == "function" or mm.kind == "variable") %}{% set _ = cmembers.append(mm) %}{% endfor %}{% set cmembers = cmembers | sort(attribute='name') %}{% if cmembers %}<details><summary class="flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden py-0.5"><span class="tk-chev"></span><a class="text-brand-primary hover:text-brand-accent" href="#{{ c.qualname }}">{{ c.name }}</a></summary><div class="mt-0.5 pl-4 mb-4"><ul class="space-y-0.5 text-[0.9rem] !m-0 !p-0">{% for mm in cmembers %}<li class="flex items-center gap-2">{{ tbadge("function" if mm.kind == "function" else "variable") }}<a class="text-brand-primary hover:text-brand-accent" href="#{{ mm.qualname }}">{{ mm.name }}</a></li>{% endfor %}</ul></div></details>{% else %}{% if ns.any_expandable %}<div class="py-0.5 pl-3.5">{% else %}<div class="py-0.5">{% endif %}<a class="text-brand-primary hover:text-brand-accent" href="#{{ c.qualname }}">{{ c.name }}</a></div>{% endif %}{% endfor %}</div></div>{% endif %}
        {% if own_functions %}<div><h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Functions</h3><ul class="space-y-1">{% for f in own_functions %}<li><a class="text-brand-primary hover:text-brand-accent" href="#{{ f.qualname }}">{{ f.name }}</a></li>{% endfor %}</ul></div>{% endif %}
        {% if reexported %}<div><h3 class="text-[0.78rem] font-semibold uppercase tracking-wider text-brand-muted mb-2">Re-exported</h3><div class="space-y-1">{% for source in re_sources %}<details><summary class="flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden py-0.5"><span class="tk-chev"></span><a class="text-brand-primary hover:text-brand-accent whitespace-nowrap" href="/{{ source.replace(".", "/") }}.html">{{ source }}</a></summary><div class="mt-0.5 pl-4 mb-4"><ul class="space-y-0.5 text-[0.9rem] !m-0 !p-0">{% for m in reexported if m.taken_from[0] == source %}<li class="flex items-center gap-2">{{ tbadge("class") }}<a class="text-brand-primary hover:text-brand-accent whitespace-nowrap" href="/{{ source.replace(".", "/") }}.html#{{ m.qualname }}">{{ m.name }}</a></li>{% endfor %}</ul></div></details>{% endfor %}</div></div>{% endif %}
      </nav>
    </aside>

    {# ---------- main ---------- #}
    <main class="flex-1 min-w-0 bg-white px-6 sm:px-10 lg:px-14 py-10">
      <div class="max-w-5xl">
        <header class="mb-8">
          <nav class="font-mono text-[0.95rem] text-brand-muted mb-3">
            <a href="/" class="text-brand-primary hover:text-brand-accent">All packages</a>
            {% set parts = module.modulename.split('.') %}
            {% for part in parts[:-1] %} :: <a href="/{{ parts[:loop.index] | join('/') }}.html" class="text-brand-primary hover:text-brand-accent">{{ part }}</a>{% endfor %}
          </nav>
          <h1 class="text-4xl font-light">{{ "Namespace" if is_namespace(module) else ("Package" if module.is_package else "Module") }} <code class="font-bold">{{ module.modulename }}</code></h1>
        </header>

        <section class="mb-4">{{ doc_html(module) }}</section>

        {% if pub_submodules %}<section class="mt-12"><h2 class="text-2xl font-light mb-5 text-brand-primary">Sub-modules</h2><div class="grid grid-cols-1 gap-4">
          {% for m in pub_submodules %}{% set parts = m.modulename.rsplit('.', 1) %}<a href="/{{ m.modulename.replace('.', '/') }}.html" class="block rounded-xl border border-black/10 bg-white p-4 transition hover:border-brand-accent hover:shadow-sm"><div class="flex items-start justify-between gap-3"><span class="font-mono text-[0.95rem] min-w-0 break-all">{% if parts | length > 1 %}<span class="text-brand-muted">{{ parts[0] }}.</span>{% endif %}<span class="text-brand-primary font-semibold">{{ parts[-1] }}</span></span><span class="shrink-0 rounded-md bg-black/[0.04] px-2 py-0.5 text-[0.62rem] uppercase tracking-wide text-brand-muted">{{ "namespace" if is_namespace(m) else ("package" if m.is_package else "module") }}</span></div>{% if glimpse(m) | trim %}<div class="tk-doc text-brand-muted text-sm mt-2 max-w-[66%]">{{ glimpse(m) | to_html }}</div>{% else %}<div class="mt-2 text-sm italic text-black/25">— no summary available</div>{% endif %}</a>{% endfor %}
        </div></section>{% endif %}

        {% if own_variables %}<section class="mt-12"><h2 class="text-2xl font-light mb-5 text-brand-primary">Global variables</h2><div class="space-y-8">
          {% for v in own_variables %}{{ show_var(v) }}{% endfor %}
        </div></section>{% endif %}

        {% if own_functions %}<section class="mt-12"><h2 class="text-2xl font-light mb-5 text-brand-primary">Functions</h2><div class="space-y-10">
          {% for f in own_functions %}{{ show_func(f) }}{% endfor %}
        </div></section>{% endif %}

        {% if own_classes %}<section class="mt-12"><h2 class="text-2xl font-light mb-5 text-brand-primary">Classes</h2><div class="space-y-24">
          {% for c in own_classes %}{{ show_class(c) }}{% endfor %}
        </div></section>{% endif %}

      </div>
    </main>
    </div>
    <footer class="border-t border-black/10 bg-white/70 px-6 py-6 text-sm text-brand-muted text-center">
      Generated with <a class="text-brand-primary hover:text-brand-accent" href="https://github.com/tokeo/tokeo">Tokeo</a> 🚀{% if tokeo_version %} ( {{ tokeo_version }} ){% endif %} and <a class="text-brand-primary hover:text-brand-accent" href="https://pdoc.dev">pdoc</a>{% if pdoc_version %} ( {{ pdoc_version }} ){% endif %}
    </footer>
  </div>
{% endblock %}
